+/* The following is copied from kernel/locking/rwsem.c */
+
+#ifndef CONFIG_PREEMPT_RT
+
+/*
+ * The least significant 2 bits of the owner value has the following
+ * meanings when set.
+ *  - Bit 0: RWSEM_READER_OWNED - rwsem may be owned by readers (just a hint)
+ *  - Bit 1: RWSEM_NONSPINNABLE - Cannot spin on a reader-owned lock
+ *
+ * When the rwsem is reader-owned and a spinning writer has timed out,
+ * the nonspinnable bit will be set to disable optimistic spinning.
+
+ * When a writer acquires a rwsem, it puts its task_struct pointer
+ * into the owner field. It is cleared after an unlock.
+ *
+ * When a reader acquires a rwsem, it will also puts its task_struct
+ * pointer into the owner field with the RWSEM_READER_OWNED bit set.
+ * On unlock, the owner field will largely be left untouched. So
+ * for a free or reader-owned rwsem, the owner value may contain
+ * information about the last reader that acquires the rwsem.
+ *
+ * That information may be helpful in debugging cases where the system
+ * seems to hang on a reader owned rwsem especially if only one reader
+ * is involved. Ideally we would like to track all the readers that own
+ * a rwsem, but the overhead is simply too big.
+ *
+ * A fast path reader optimistic lock stealing is supported when the rwsem
+ * is previously owned by a writer and the following conditions are met:
+ *  - rwsem is not currently writer owned
+ *  - the handoff isn't set.
+ */
+#define RWSEM_READER_OWNED	(1UL << 0)
+#define RWSEM_NONSPINNABLE	(1UL << 1)
+#define RWSEM_OWNER_FLAGS_MASK	(RWSEM_READER_OWNED | RWSEM_NONSPINNABLE)
+
+/*
+ * On 64-bit architectures, the bit definitions of the count are:
+ *
+ * Bit  0    - writer locked bit
+ * Bit  1    - waiters present bit
+ * Bit  2    - lock handoff bit
+ * Bits 3-7  - reserved
+ * Bits 8-62 - 55-bit reader count
+ * Bit  63   - read fail bit
+ *
+ * On 32-bit architectures, the bit definitions of the count are:
+ *
+ * Bit  0    - writer locked bit
+ * Bit  1    - waiters present bit
+ * Bit  2    - lock handoff bit
+ * Bits 3-7  - reserved
+ * Bits 8-30 - 23-bit reader count
+ * Bit  31   - read fail bit
+ *
+ * It is not likely that the most significant bit (read fail bit) will ever
+ * be set. This guard bit is still checked anyway in the down_read() fastpath
+ * just in case we need to use up more of the reader bits for other purpose
+ * in the future.
+ *
+ * atomic_long_fetch_add() is used to obtain reader lock, whereas
+ * atomic_long_cmpxchg() will be used to obtain writer lock.
+ *
+ * There are three places where the lock handoff bit may be set or cleared.
+ * 1) rwsem_mark_wake() for readers		-- set, clear
+ * 2) rwsem_try_write_lock() for writers	-- set, clear
+ * 3) rwsem_del_waiter()			-- clear
+ *
+ * For all the above cases, wait_lock will be held. A writer must also
+ * be the first one in the wait_list to be eligible for setting the handoff
+ * bit. So concurrent setting/clearing of handoff bit is not possible.
+ */
+#define RWSEM_WRITER_LOCKED	(1UL << 0)
+#define RWSEM_FLAG_WAITERS	(1UL << 1)
+#define RWSEM_FLAG_HANDOFF	(1UL << 2)
+#define RWSEM_FLAG_READFAIL	(1UL << (BITS_PER_LONG - 1))
+
+#define RWSEM_READER_SHIFT	8
+#define RWSEM_READER_BIAS	(1UL << RWSEM_READER_SHIFT)
+#define RWSEM_READER_MASK	(~(RWSEM_READER_BIAS - 1))
+#define RWSEM_WRITER_MASK	RWSEM_WRITER_LOCKED
+#define RWSEM_LOCK_MASK		(RWSEM_WRITER_MASK|RWSEM_READER_MASK)
+#define RWSEM_READ_FAILED_MASK	(RWSEM_WRITER_MASK|RWSEM_FLAG_WAITERS|\
+				 RWSEM_FLAG_HANDOFF|RWSEM_FLAG_READFAIL)
+
+/*
+ * Return just the real task structure pointer of the owner
+ */
+static struct task_struct *priv_rwsem_owner(struct rw_semaphore *sem)
+{
+	return (struct task_struct *)
+		(atomic_long_read(&sem->owner) & ~RWSEM_OWNER_FLAGS_MASK);
+}
+
+/*
+ * Return true if the rwsem is owned by a reader.
+ */
+static bool priv_is_rwsem_reader_owned(struct rw_semaphore *sem)
+{
+	/*
+	 * Check the count to see if it is write-locked.
+	 */
+	long count = atomic_long_read(&sem->count);
+
+	if (count & RWSEM_WRITER_MASK)
+		return false;
+	return atomic_long_read(&sem->owner) & RWSEM_READER_OWNED;
+}
+
+#endif
+
 static vm_fault_t vgpu_mmio_fault(struct vm_fault *vmf)
 {
     int ret;
@@ -4632,9 +4776,46 @@ static vm_fault_t vgpu_mmio_fault(struct vm_fault *vmf)
 
     pg_prot = nv_adjust_pgprot(pg_prot);
 
+    /*
+     * Testing shows that fault handlers are called with read locks,
+     * but this operation requires a write lock. Therefore, temporarily upgrade ours.
+     *
+     * While this could (theoretically) race with another thread,
+     * and this code isn't necessarily hardened enough to deal with that,
+     * testing also shows that it only ever has one owner/holder.
+     */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 7, 0)
+    struct rw_semaphore *mmap_lock = &vma->vm_mm->mmap_lock;
+#else
+    struct rw_semaphore *mmap_lock = &vma->vm_mm->mmap_sem;
+#endif
+
+    bool upgraded = false;
+    int mmap_lock_acquired = down_write_trylock(mmap_lock);
+    if (mmap_lock_acquired) {
+        NV_VGPU_DEV_LOG(VGPU_ERR, vgpu_dev,
+                        "ATTN: The triggered fault doesn't even hold a read lock to its memory. This is unusual.\n");
+    // TODO: Are there any other tolerable conditions?
+    } else if (priv_rwsem_owner(mmap_lock) == current && priv_is_rwsem_reader_owned(mmap_lock) && (atomic_long_read(&mmap_lock->count) >> RWSEM_READER_SHIFT) == 1) {
+        up_read(mmap_lock);
+        down_write(mmap_lock);
+        mmap_lock_acquired = 1;
+        upgraded = true;
+    } else {
+        NV_VGPU_DEV_LOG(VGPU_ERR, vgpu_dev, "ATTN: Unable to upgrade to the needed write lock! This is bad.\n");
+        NV_VGPU_DEV_LOG(VGPU_ERR, vgpu_dev, "Continuing anyways, as NVIDIA did, but this may induce memory corruption.\n");
+    }
+
     ret = remap_pfn_range(vma, virtaddr, (host_addr >> PAGE_SHIFT),
                           req_size, pg_prot);
 
+    if (mmap_lock_acquired) {
+        up_write(mmap_lock);
+        if (upgraded) {
+            down_read(mmap_lock);
+        }
+    }
+
     if (ret != 0)
         NV_VGPU_DEV_LOG(VGPU_ERR, vgpu_dev,
                         "Failed to do mmap for fault handler. ret: %d\n", ret);
